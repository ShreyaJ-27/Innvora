# StockPulse Frontend Configuration

# Base URL of the deployed API Gateway (no trailing slash)
VITE_API_BASE_URL=https://1d1j9fcft5.execute-api.ap-south-1.amazonaws.com/prod

# Set to false to connect to the real backend; true uses the local mock adapter
VITE_USE_MOCK_API=false

# Enable demo event simulator UI in topbar (safe to keep enabled)
VITE_ENABLE_DEMO_TOOLS=true
